# Versions for local transcription. Single source of truth: read by server.js,
# sync-wrapper.sh and setup-whisper.sh. Before changing them, test them
# (setup-whisper.sh runs a test transcription).
#
# Per-user settings go in ~/.wacrawl/whisper.env (same format), which overrides this file.
WHISPER_PYTHON=3.12
WHISPER_PACKAGE=mlx-whisper==0.4.3
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Language of the voice notes: en, es, pt… Empty = detect it per voice note.
WHISPER_LANGUAGE=
