<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openclaw.wacrawl.sync</string>

    <!-- Llama al wrapper, no a wacrawl directo: el wrapper detecta el error de
         "different event", se auto-recupera con backup, y avisa si algo falla.
         Sin él, un sync roto pasa desapercibido durante días. -->
    <key>ProgramArguments</key>
    <array>
        <string>__WRAPPER__</string>
    </array>

    <!-- cada 6 horas -->
    <key>StartInterval</key>
    <integer>21600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>Nice</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.wacrawl/sync.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.wacrawl/sync.err.log</string>
</dict>
</plist>
